# ── App ──────────────────────────────────────
NODE_ENV=development
APP_ROLE=api
PORT=3000
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://traineon:traineon@localhost:5432/traineon_app
DATABASE_POOL_SIZE=5

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────
JWT_ACCESS_SECRET=change-me-min-32-chars-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=change-me-different-min-32-chars-secret
JWT_REFRESH_TTL_SECONDS=604800
WS_TICKET_TTL_SECONDS=30

# ── LLM ───────────────────────────────────────
# No gateway. Providers + models + keys are configured at runtime via /llm
# (LangChain.js builds chat models in-process from the encrypted DB registry).

# AES-256-GCM key for encrypting provider API keys at rest (min 32 chars)
CREDENTIAL_ENCRYPTION_KEY=change-me-min-32-chars-random-secret

# ── ClickHouse ────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=traineon
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ── Rate limiting ──────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# ── Worker ────────────────────────────────────
WORKER_CONCURRENCY=5

# ── Sessions ──────────────────────────────────
# Idle ACTIVE sessions older than this are reaped → ABANDONED (cron every 5 min)
SESSION_IDLE_TIMEOUT_MINUTES=30

# ── Observability ─────────────────────────────
LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# ── LangSmith (LangChain/LangGraph tracing + evals) ──
# Off by default. When true, prompts + completions are sent to LangSmith —
# a data-governance decision (see docs/LANGSMITH_SETUP.md). Keep off in prod
# unless approved. Recommended: on in dev/staging only.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=traineon-dev
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ── Credential verifier ───────────────────────
CREDENTIAL_VERIFIER=local
# EXTERNAL_AUTH_URL=

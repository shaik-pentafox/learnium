generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Roles ─────────────────────────────────────────────────────────────────────

model RoleDef {
  id    Int    @id @default(autoincrement())
  name  String @unique // SUPER_ADMIN | TRAINER | USER
  users User[]

  @@map("role_defs")
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  employeeId   String    @unique
  email        String    @unique
  firstName    String
  lastName     String
  roleId       Int
  role         RoleDef   @relation(fields: [roleId], references: [id])
  supervisorId     Int?
  supervisor       User?    @relation("UserSupervisor", fields: [supervisorId], references: [id])
  supervisees      User[]   @relation("UserSupervisor")
  assignedPersonaId Int?
  assignedPersona  Persona? @relation("AssignedPersona", fields: [assignedPersonaId], references: [id])
  avatarUrl        String?
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  Int?
  updatedById  Int?

  credential      DefaultCredential?
  refreshTokens   RefreshToken[]
  realtimeTickets RealtimeTicket[]
  sessions        Session[]

  @@map("users")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model DefaultCredential {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  userId       Int    @unique
  user         User   @relation(fields: [userId], references: [id])

  @@map("default_credentials")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model RealtimeTicket {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("realtime_tickets")
}

// ── Personas ──────────────────────────────────────────────────────────────────

model VoiceStyle {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  provider String    // legacy voice-style provider label (pre-registry)
  voiceId  String
  personas Persona[]

  @@map("voice_styles")
}

// ── LLM Registry ─────────────────────────────────────────────────────────────

// Seeded catalog of providers the admin may configure. Admin picks one, supplies
// an API key → a LlmProvider row is created linked back here. Updated by re-running
// `npm run seed:llm` (upsert by `key`), never edited via the API.
model MasterProvider {
  id             Int           @id @default(autoincrement())
  key            String        @unique // 'openai' | 'google' | 'anthropic'
  name           String // display: "OpenAI", "Google Gemini", ...
  // Runtime construct branch (model factory / voice factory dispatch).
  adapterType    String // 'openai' | 'gemini' | 'anthropic'
  defaultBaseUrl String?
  supports       String[] // ['chat'] | ['chat','voice'] | ['voice']
  models         MasterModel[]
  configured     LlmProvider[]

  @@map("master_providers")
}

// Seeded catalog of models per master provider (chat + voice). Chat rows carry
// pricing/context metadata; voice rows carry pipeline/languages/voices.
model MasterModel {
  id                    Int            @id @default(autoincrement())
  masterProviderId      Int
  masterProvider        MasterProvider @relation(fields: [masterProviderId], references: [id])
  key                   String // provider model id: 'gpt-4o-mini', 'gpt-4o-realtime-preview'
  name                  String // display
  kind                  String // 'chat' | 'voice'
  contextWindowTokens   Int? // chat
  inputPricePerMillion  Float? // chat
  outputPricePerMillion Float? // chat
  voicePipeline         String? // voice: 's2s' | 'stt+tts'
  languages             String[] // voice: BCP-47 codes
  voices                String[] // voice: provider voice ids
  configured            LlmModel[]

  @@unique([masterProviderId, key])
  @@map("master_models")
}

model LlmProvider {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  type             String
  baseUrl          String?
  credentialRef    String?
  // Masked key for display ("sk-…abc4") — computed on write, safe to return.
  credentialHint   String?
  isEnabled        Boolean         @default(true)
  monthlyBudgetUsd Float?
  // Master catalog link. Null = legacy/manually-created row (pre-masters).
  masterProviderId Int?
  masterProvider   MasterProvider? @relation(fields: [masterProviderId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  models           LlmModel[]

  @@map("llm_providers")
}

model LlmModel {
  id                    Int          @id @default(autoincrement())
  name                  String       @unique
  providerId            Int
  provider              LlmProvider  @relation(fields: [providerId], references: [id])
  // 'chat' | 'voice'. isDefault invariant is scoped per kind: exactly one
  // primary chat model AND one primary voice model (may be different providers).
  kind                  String       @default("chat")
  capabilities          String[]
  contextWindowTokens   Int?
  inputPricePerMillion  Float?
  outputPricePerMillion Float?
  isDefault             Boolean      @default(false)
  // Master catalog link. Null = legacy row; voice metadata (pipeline, languages,
  // voices) is always read from the master at runtime.
  masterModelId         Int?
  masterModel           MasterModel? @relation(fields: [masterModelId], references: [id])
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  conversationPersonas  Persona[]    @relation("ConversationModel")
  scoringPersonas       Persona[]    @relation("ScoringModel")
  voicePersonas         Persona[]    @relation("VoiceModel")

  @@map("llm_models")
}

// Per-call LLM usage + cost telemetry. Written on each chat turn / scoring run.
model LlmUsage {
  id           Int      @id @default(autoincrement())
  kind         String   // chat | scoring
  modelId      Int?
  modelName    String
  providerType String?
  sessionId    Int?
  userId       Int?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Float    @default(0)
  estimated    Boolean  @default(false) // tokens approximated (provider returned no usage)
  latencyMs    Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([modelId])
  @@map("llm_usage")
}

model Persona {
  id                  Int              @id @default(autoincrement())
  name                String
  description         String?
  // Hex accent color for the persona's chat orb/avatar (e.g. "#6366f1").
  color               String?
  isPublished         Boolean   @default(false)
  // Structured authoring fields (source of truth). The runtime prompt is
  // rendered from these; `systemPrompt` is a rendered cache kept for preview.
  templateData        Json?
  systemPrompt        String
  customInstructions  String?
  voiceStyleId        Int?
  voiceStyle          VoiceStyle?      @relation(fields: [voiceStyleId], references: [id])
  // BCP-47 codes the trainee may pick from when starting a voice session (e.g.
  // ["hi-IN","en-IN"]). Empty = voice disabled / text-only persona.
  languages           String[]         @default([])
  conversationModelId Int?
  conversationModel   LlmModel?        @relation("ConversationModel", fields: [conversationModelId], references: [id])
  scoringModelId      Int?
  scoringModel        LlmModel?        @relation("ScoringModel", fields: [scoringModelId], references: [id])
  // Voice model pin (kind='voice'). Null = use the primary voice model.
  voiceModelId        Int?
  voiceModel          LlmModel?        @relation("VoiceModel", fields: [voiceModelId], references: [id])
  // Provider voice name for the persona (e.g. 'alloy', 'Puck', 'priya').
  // Must be one of the voice model's catalog voices. Null = model's first voice.
  voiceId             String?
  isDeleted           Boolean          @default(false)
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  versions            PersonaVersion[]
  scoreCriteria       ScoreCriterion[]
  assignedUsers       User[]           @relation("AssignedPersona")
  sessions            Session[]

  @@map("personas")
}

model PersonaVersion {
  id                 Int      @id @default(autoincrement())
  personaId          Int
  persona            Persona  @relation(fields: [personaId], references: [id])
  version            Int
  templateData       Json?
  systemPrompt       String
  customInstructions String?
  snapshotData       Json
  createdById        Int?
  createdAt          DateTime @default(now())

  @@unique([personaId, version])
  @@index([personaId])
  @@map("persona_versions")
}

model ScoreCriterion {
  id          Int     @id @default(autoincrement())
  personaId   Int
  persona     Persona @relation(fields: [personaId], references: [id])
  name        String
  description String?
  maxScore    Int     @default(10)
  weight      Float   @default(1.0)
  order       Int     @default(0)

  scoreResults ScoreResult[]

  @@index([personaId])
  @@map("score_criteria")
}

// ── Sessions ──────────────────────────────────────────────────────────────────

model Session {
  id        Int           @id @default(autoincrement())
  uid       String        @unique @default(uuid())
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  personaId Int
  persona   Persona       @relation(fields: [personaId], references: [id])
  status    String        @default("ACTIVE") // ACTIVE | COMPLETED | ABANDONED
  feedback  String?
  isSimulation Boolean       @default(false)
  // Voice session: STT/TTS loop instead of text. `languageCode` is the trainee's
  // chosen language at start (must be one of persona.languages).
  isVoice      Boolean       @default(false)
  languageCode String?
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  scores    ScoreResult[]

  @@index([userId])
  @@index([personaId])
  @@map("sessions")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  session    Session  @relation(fields: [sessionId], references: [id])
  role       String   // user | assistant
  content    String
  tokenCount Int?
  /** Per-message timing (ms). assistant = LLM generation time; user = trainee
   *  response/think time since the previous message. */
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model ScoreResult {
  id          Int            @id @default(autoincrement())
  sessionId   Int
  session     Session        @relation(fields: [sessionId], references: [id])
  criterionId Int
  criterion   ScoreCriterion @relation(fields: [criterionId], references: [id])
  score       Float?
  maxScore    Int
  feedback    String?
  createdAt   DateTime       @default(now())

  @@index([sessionId])
  @@map("score_results")
}

// ── Bulk Import ───────────────────────────────────────────────────────────────

model ImportReport {
  id          String   @id @default(uuid())
  userId      Int
  status      String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  errorData   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("import_reports")
}
